<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    {{ 'styles.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    {% section 'header' %}
    {{ content_for_layout }}
    {% section 'footer' %}

    <script>
      window.SBS_LOGO_FRAMES = [
        {{ 'logo-frame-0.png' | asset_url | json }},
        {{ 'logo-frame-1.png' | asset_url | json }},
        {{ 'logo-frame-2.png' | asset_url | json }},
        {{ 'logo-frame-3.png' | asset_url | json }},
        {{ 'logo-frame-4.png' | asset_url | json }},
        {{ 'logo-frame-5.png' | asset_url | json }}
      ];
    </script>
    <script src="{{ 'logo.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
  </body>
</html>
