<main class="home-main">
  <form action="{{ routes.search_url }}" method="get" class="giveaway-form" role="search">
    <div class="giveaway-field">
      <label for="search">Search</label>
      <input id="search" type="search" name="q" value="{{ search.terms | escape }}">
    </div>
    <button class="giveaway-submit" type="submit">Search</button>
  </form>

  {%- if search.performed -%}
    <div class="product-grid" style="margin-top: 2rem;">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- endif -%}
      {%- else -%}
        <p>No results</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</main>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
