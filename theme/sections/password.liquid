<main class="giveaway-page">
  <header class="site-header">
    <span class="logo-link">
      {% render 'logo' %}
    </span>
  </header>
  <div class="giveaway-intro">
    <h1>{{ shop.name }}</h1>
    <p>{{ 'password.title' | t }}</p>
  </div>
  {% form 'storefront_password', class: 'giveaway-form' %}
    <div class="giveaway-field">
      <label for="password">{{ 'password.password' | t }}</label>
      <input id="password" type="password" name="password" autocomplete="current-password">
    </div>
    <button class="giveaway-submit" type="submit">{{ 'password.submit' | t }}</button>
  {% endform %}
</main>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
